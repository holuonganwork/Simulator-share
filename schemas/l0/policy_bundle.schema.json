{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsm-driver-agent/schemas/l0/policy_bundle",
  "title": "policy_bundle",
  "description": "Nguồn số tài chính DUY NHẤT cùng payout_ledger. Version hóa — US-F0-03. Pain #4.",
  "type": "object",
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC+7 (data đã normalize — spec §0 assumption)"
    },
    "effective_to": {
      "type": "string",
      "format": "date-time",
      "description": "null = đang hiệu lực"
    },
    "track": {
      "type": "string",
      "enum": [
        "core_owned",
        "platform",
        "rto",
        "green_bike_unspecified"
      ],
      "description": "guardrail T-004: unspecified KHÔNG auto-map"
    },
    "service": {
      "type": "string"
    },
    "fare": {
      "type": "object",
      "required": [
        "base_vnd",
        "base_km",
        "per_km_vnd"
      ],
      "properties": {
        "base_vnd": {
          "type": "integer",
          "minimum": 0,
          "description": "VND nguyên (không âm)"
        },
        "base_km": {
          "type": "number",
          "minimum": 0
        },
        "per_km_vnd": {
          "type": "integer",
          "minimum": 0,
          "description": "VND nguyên (không âm)"
        }
      },
      "additionalProperties": false
    },
    "car_classes": {
      "type": "object",
      "description": "Biểu giá và định mức năng lượng theo từng phân hạng xe ô tô điện (A_COMPACT, C_SUV, D_LUXURY, LIMO)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_vnd": { "type": "integer", "minimum": 0 },
          "base_km": { "type": "number", "minimum": 0 },
          "per_km_vnd": { "type": "integer", "minimum": 0 },
          "driver_share": { "type": "number", "minimum": 0, "maximum": 1 },
          "battery_kwh": { "type": "number", "minimum": 0 },
          "kwh_per_100km": { "type": "number", "minimum": 0 }
        }
      }
    },
    "driver_share": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "points": {
      "type": "object",
      "required": [
        "peak",
        "normal",
        "peak_hours",
        "window_hours"
      ],
      "properties": {
        "peak": {
          "type": "integer"
        },
        "normal": {
          "type": "integer"
        },
        "peak_hours": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "window_hours": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "day_bonus_tiers": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer",
            "minimum": 0,
            "description": "VND nguyên (không âm)"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "weekly_quota": {
      "type": [
        "object",
        "null"
      ],
      "description": "Khoán tuần + truy thu (Vận Doanh 23/02/2026). Optional — số TBC-với-GSM (image-locked). money basis = GROSS (doanh số) theo quyết định (d) 2026-07-24.",
      "properties": {
        "min_revenue_vnd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Doanh số (GROSS) tối thiểu/tuần. null = chưa có số thật → solver KHÔNG được bịa"
        },
        "min_active_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "clawback_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "0.20 toàn quốc; tới 0.40 HN/HCM (04/05/2026) — versioned theo market"
        },
        "market_scope": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "bonus_min_acceptance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bonus_min_completion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "forced_accept_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "MOCK",
        "REAL",
        "ESTIMATED",
        "COARSE",
        "INFERRED"
      ],
      "description": "Nhãn nguồn bắt buộc (CLAUDE.md §5 — mock phải gắn nhãn)"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "costs": {
      "type": "object",
      "description": "B3 (PLAN-cycle-wx, 2026-07-29): CHI PHÍ theo policy — nguồn số duy nhất cho số hạng chi phí của solver (vế A5 VISION-ALIGNMENT). Optional (bundle 1.0.0 không có ⇒ resolve trả UNKNOWN, không bịa). Nguồn giá trị: research/economics/driver-cost-structure-2026.md (official).",
      "properties": {
        "battery_free_until": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "description": "Hạn miễn phí đổi pin của track này (Platform độc quyền: 2029-03-31, official greensm 26/03/2026). null = không có ưu đãi"
        },
        "swap_fee_vnd": {
          "type": "number",
          "minimum": 0,
          "description": "Phí một lượt đổi pin SAU hạn ưu đãi (official: 9.000đ)"
        },
        "battery_rent_vnd_month": {
          "type": "number",
          "minimum": 0
        },
        "swap_range_km_per_pack": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Tầm hoạt động một pack — quy swap_fee ra đ/km"
        },
        "cash_cost_vnd_per_km_by_track": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "đ/km tiền mặt theo track (charge: 70–93 từ giá điện EVN; platform swap: 0 trong hạn ưu đãi)"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "bundle_id",
    "driver_share",
    "effective_from",
    "fare",
    "schema_version",
    "service",
    "source",
    "track",
    "version"
  ],
  "additionalProperties": false
}
