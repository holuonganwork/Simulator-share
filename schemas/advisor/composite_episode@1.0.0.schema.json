{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsm-driver-agent/schemas/advisor/composite_episode@1.0.0",
  "title": "composite_episode",
  "description": "Derived driver-journey state assembled from raw events, observer snapshots, solver reports, checkpoint revisions, execution segments and the income ledger. An episode is not a card: routing decides whether it earns a surface, and only an interrupting nudge becomes an advice_checkpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "run_id",
    "actor_id",
    "driver_id",
    "episode_type",
    "material_revision",
    "detected_at_min",
    "started_at_min",
    "last_updated_at_min",
    "valid_from_min",
    "evidence_window_start_min",
    "evidence_window_end_min",
    "status",
    "lifecycle_state",
    "recommended_surface",
    "interruption_class",
    "priority",
    "confidence",
    "authority",
    "evidence_mode",
    "data_mode",
    "is_mock",
    "component_signals",
    "derived_facts",
    "numbers",
    "caveats",
    "template_key",
    "material_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^ep-[0-9a-f]{24}$"
    },
    "run_id": {
      "type": "string"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_id": {
      "type": "integer"
    },
    "driver_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_type": {
      "type": "string",
      "enum": [
        "energy_pressure_building",
        "energy_episode_recovered",
        "plan_slipping_not_driver_failing",
        "plan_stability",
        "rest_debt_vs_idle",
        "income_quality_not_amount",
        "stop_chasing_infeasible_target"
      ]
    },
    "material_revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "detected_at_min": {
      "type": "number"
    },
    "started_at_min": {
      "type": "number"
    },
    "last_updated_at_min": {
      "type": "number"
    },
    "valid_from_min": {
      "type": "number"
    },
    "valid_until_min": {
      "type": [
        "number",
        "null"
      ]
    },
    "evidence_window_start_min": {
      "type": "number"
    },
    "evidence_window_end_min": {
      "type": "number",
      "description": "Never greater than detected_at_min: the evidence window may not contain the future."
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "RECOVERED",
        "CLOSED",
        "EXPIRED"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "DETECTED",
        "BUILDING",
        "ACTIONABLE",
        "RECOVERING",
        "RECOVERED",
        "STABLE",
        "UNSTABLE",
        "UPDATING",
        "EXPLAINED",
        "CLOSED_INFEASIBLE",
        "SUMMARISED",
        "EXPIRED"
      ]
    },
    "current_action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "label_id",
        "authority",
        "source_ref"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "label_id": {
          "type": "string"
        },
        "window": {
          "type": [
            "object",
            "null"
          ]
        },
        "authority": {
          "const": "SOLVER"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "future_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "label_id",
          "authority",
          "source_ref"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label_id": {
            "type": "string"
          },
          "window": {
            "type": [
              "object",
              "null"
            ]
          },
          "authority": {
            "const": "SOLVER"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "action_window": {
      "type": [
        "object",
        "null"
      ]
    },
    "recommended_surface": {
      "type": "string",
      "enum": [
        "NUDGE",
        "PLAN_STRIP",
        "INSIGHT_DRAWER",
        "PRIORITY_BOARD",
        "TIMELINE",
        "RECAP",
        "WHY",
        "BRIEF"
      ]
    },
    "interruption_class": {
      "type": "string",
      "enum": [
        "INTERRUPTIVE",
        "PERSISTENT",
        "PASSIVE",
        "ON_DEMAND",
        "DEFERRED"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "authority": {
      "type": "string",
      "enum": [
        "SOLVER",
        "POLICY",
        "OBSERVATION",
        "DERIVED_RULE"
      ]
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "INFERRED"
      ]
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "REAL",
        "LIVE",
        "MOCK",
        "SIMULATED"
      ]
    },
    "is_mock": {
      "type": "boolean"
    },
    "component_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_type",
          "at_min",
          "value",
          "unit",
          "source",
          "source_ref",
          "evidence_mode",
          "data_mode",
          "confidence",
          "ref"
        ],
        "properties": {
          "signal_type": {
            "type": "string",
            "minLength": 1
          },
          "at_min": {
            "type": "number"
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_mode": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "INFERRED"
            ]
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "REAL",
              "LIVE",
              "MOCK",
              "SIMULATED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "freshness_min": {
            "type": [
              "number",
              "null"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derived_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "unit",
          "method",
          "from_signals",
          "evidence_mode"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "from_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_mode": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "INFERRED"
            ]
          }
        }
      }
    },
    "numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "unit",
          "source"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "from_signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_checkpoint_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_solver_report_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_segment_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_observation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "template_key": {
      "type": "string",
      "minLength": 1
    },
    "presentation_params": {
      "type": "object"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material_fingerprint": {
      "type": "string",
      "minLength": 1
    }
  }
}
