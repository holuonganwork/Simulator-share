{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsm-driver-agent/schemas/advisor/advice_checkpoint",
  "title": "advice_checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "driver_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "enum": ["bonus_eligibility", "energy", "rest", "shift_boundary", "shift_timing", "positioning_sim_only", "policy_info", "safety_reserved"]},
    "surface": {"type": "string", "enum": ["brief", "nudge", "recap"]},
    "trigger_type": {"type": "string", "enum": ["state_change", "poll", "user_pull", "timer", "solver_update"]},
    "current_action": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "label_id": {"type": "string"}},
      "required": ["code", "label_id"]
    },
    "future_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string"},
          "label_id": {"type": "string"},
          "window": {"type": ["object", "null"]}
        },
        "required": ["code", "label_id"]
      }
    },
    "action_window": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "required": ["start", "end"]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "freshness_deadline": {"type": "string", "format": "date-time"}
      },
      "required": ["valid_from", "valid_until", "freshness_deadline"]
    },
    "urgency_band": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "material_revision": {"type": "string", "minLength": 1},
    "reason_code": {"type": "string", "minLength": 1},
    "confidence_band": {"type": "string", "enum": ["low", "medium", "high"]},
    "numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "value", "unit", "source"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "string", "null"]},
          "unit": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "caveats": {"type": "array", "items": {"type": "string"}},
    "fingerprint": {"type": "string", "minLength": 1},
    "snapshot_ref": {"type": "string", "minLength": 1},
    "solver_artifact_ref": {"type": "string", "minLength": 1},
    "source_decision_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "solver_input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "solver_report_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_episode_id": {"type": ["string", "null"]},
    "episode_type": {"type": ["string", "null"]},
    "decision_key": {"type": "string", "minLength": 1},
    "output_intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent_id": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["ACTION", "EXPLANATION", "OBSERVATION", "SUMMARY", "INTERNAL_ONLY"]},
        "driver_job": {"type": "string", "minLength": 1},
        "must_answer": {"type": "array", "items": {"type": "string", "enum": ["WHAT_CHANGED", "ACTION_NOW", "ACTION_NEXT", "WINDOW", "WHY", "EVIDENCE", "UNCERTAINTY", "NO_ACTION"]}}
      },
      "required": ["intent_id", "mode", "driver_job", "must_answer"]
    },
    "evidence_quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["SUFFICIENT", "INSUFFICIENT", "LOW_QUALITY", "UNMEASURED"]},
        "required_signal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "available_signal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["status", "required_signal_ids", "available_signal_ids", "reasons"]
    },
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "solver_set": {"type": "array", "items": {"type": "string"}},
    "data_mode": {"type": "string", "enum": ["synthetic", "mock-realdata", "live"]},
    "is_mock": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": ["schema_version", "checkpoint_id", "driver_id", "topic", "surface", "trigger_type", "current_action", "future_plan", "action_window", "validity", "urgency_band", "material_revision", "reason_code", "confidence_band", "numbers", "caveats", "fingerprint", "snapshot_ref", "solver_artifact_ref", "source_decision_id", "run_id", "solver_input_refs", "solver_report_refs", "source_episode_id", "episode_type", "decision_key", "output_intent", "evidence_quality", "evidence_refs", "solver_set", "data_mode", "is_mock", "created_at"]
}
