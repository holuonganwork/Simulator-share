{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsm-driver-agent/schemas/advisor/agent_explanation_input",
  "title": "agent_explanation_input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_type": {"const": "explain_why"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "display_id": {"type": "string", "minLength": 1},
    "surface": {"enum": ["brief", "nudge", "recap"]},
    "locale": {"type": "string", "minLength": 2},
    "topic": {"type": "string", "minLength": 1},
    "canonical_action": {"type": "object", "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "label_id": {"type": "string"}},
      "required": ["code", "label_id"]},
    "current_action": {"type": "object", "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "label_id": {"type": "string"}},
      "required": ["code", "label_id"]},
    "future_plan": {"type": "array", "items": {"type": "object",
      "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "label_id": {"type": "string"},
                    "window": {"type": ["object", "null"]}},
      "required": ["code", "label_id"]}},
    "action_window": {"type": ["object", "null"]},
    "facts": {"type": "array", "items": {"type": "object",
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "value": {"type": "string"}},
      "required": ["id", "value"]}},
    "numbers": {"type": "array", "items": {"type": "object",
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "value": {"type": "number"},
                    "unit": {"type": "string"}, "source": {"type": "string"}},
      "required": ["id", "value", "unit", "source"]}},
    "confidence_band": {"enum": ["low", "medium", "high"]},
    "caveats": {"type": "array", "items": {"type": "object",
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "value": {"type": "string"}},
      "required": ["id", "value"]}},
    "presentation_text": {"type": "object", "additionalProperties": false,
      "properties": {"title": {"type": "string"}, "summary": {"type": "string"}},
      "required": ["title", "summary"]},
    "checkpoint_status": {"type": "string", "minLength": 1},
    "is_historical": {"type": "boolean"},
    "summary_max_chars": {"const": 120},
    "why_max_chars": {"const": 280}
  },
  "required": ["schema_version", "request_type", "checkpoint_id", "display_id",
    "surface", "locale", "topic", "canonical_action", "current_action", "future_plan",
    "action_window", "facts", "numbers", "confidence_band", "caveats",
    "presentation_text", "checkpoint_status", "is_historical", "summary_max_chars",
    "why_max_chars"]
}
