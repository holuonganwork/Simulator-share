    },
    "point_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rewards": {
      "type": "object",
      "description": "phần thưởng (vnd/point) + điều kiện"
    },
    "mission_claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "mission_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "time_claim_reward": {
      "type": [
        "string",
        "null"
      ]
