{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsm-driver-agent/schemas/l2/station_state",
  "title": "station_state",
  "description": "Pin ready/charging theo (bucket, station). Pain #1. Telemetry TBC → ESTIMATED từ tx flow.",
  "type": "object",
  "properties": {
    "bucket": {
      "type": "string",
      "description": "bucket 15ph ISO start"
    },
    "station_id": {
      "type": "string"
    },
    "n_ready": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "n_charging": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "estimate_label": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "MEASURED",
        "ESTIMATED",
        null
      ]
    },
    "derivation_version": {
      "type": "string",
      "description": "version của derivation job (code, không sửa tay)"
    },
    "source": {
      "type": "string",
      "enum": [
        "MOCK",
        "REAL",
        "ESTIMATED",
        "COARSE",
        "INFERRED"
      ],
      "description": "Nhãn nguồn bắt buộc (CLAUDE.md §5 — mock phải gắn nhãn)"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "bucket",
    "derivation_version",
    "schema_version",
    "source",
    "station_id"
  ],
  "additionalProperties": false
}
